<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>แบบฝึกหัดวิเคราะห์โครงสร้างประโยคและอนุประโยคภาษาเกาหลี (한국어 겹문장과 안긴 절)</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Noto Sans Thai & Noto Sans KR -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            thai: ['"Noto Sans Thai"', 'sans-serif'],
            korean: ['"Noto Sans KR"', '"Noto Sans Thai"', 'sans-serif'],
          },
          colors: {
            paper: '#f8f7f4',
          },
        },
      },
    };
  </script>

  <style>
    body {
      font-family: 'Noto Sans Thai', sans-serif;
      background-color: #f8f7f4;
    }
    .font-kr {
      font-family: 'Noto Sans KR', 'Noto Sans Thai', sans-serif;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.25s ease-out forwards;
    }
    @keyframes popIn {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    /* Custom scrollbar for horizontal filter bars on mobile */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col antialiased selection:bg-blue-100 selection:text-blue-900">

  <!-- Toast Notification Container (No alert/confirm) -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none max-w-sm w-full px-3 sm:px-0"></div>

  <!-- Header -->
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/90 sticky top-0 z-30 shadow-xs">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <!-- Brand & Title -->
        <div class="flex items-start gap-3.5">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center shrink-0 shadow-sm font-kr font-bold text-xl">
            절
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-base sm:text-lg md:text-xl font-bold text-slate-900 leading-snug">
                แบบฝึกหัดวิเคราะห์โครงสร้างประโยคและอนุประโยคภาษาเกาหลี
              </h1>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5 flex flex-wrap items-center gap-x-2">
              <span class="font-kr font-medium text-indigo-700">한국어 겹문장과 안긴 절</span>
              <span class="hidden sm:inline text-slate-300">•</span>
              <span>อ้างอิงตำรา <span class="font-kr text-slate-600">《시와 그림이 있는 한국어 표현 문법》</span> บทที่ 1–4</span>
            </p>
          </div>
        </div>

        <!-- Primary Navigation Tabs -->
        <nav class="flex items-center p-1 bg-slate-100 rounded-2xl border border-slate-200/80 shrink-0 self-start md:self-center" role="tablist">
          <button
            id="tab-practice"
            type="button"
            class="main-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-1.5"
            data-view="practice"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>แบบฝึกหัดวิเคราะห์ประโยค</span>
          </button>
          <button
            id="tab-guide"
            type="button"
            class="main-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-1.5"
            data-view="guide"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span>คู่มือไวยากรณ์ (บทที่ 1–4)</span>
          </button>
        </nav>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6">

    <!-- ========================================================= -->
    <!-- VIEW 1: INTERACTIVE PRACTICE MODE                         -->
    <!-- ========================================================= -->
    <div id="view-practice" class="space-y-5">

      <!-- Category Filter & Status Bar -->
      <section class="bg-white rounded-3xl border border-slate-200/80 shadow-xs p-4 space-y-3.5">
        <!-- Category Filter Chips -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5" id="category-filters" role="tablist" aria-label="ตัวกรองประเภทอนุประโยค">
          <!-- Injected by JS -->
        </div>

        <!-- Progress Bar & Controls Row -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-slate-100">
          <!-- Progress & Score -->
          <div class="flex flex-wrap items-center gap-2.5">
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 text-xs sm:text-sm font-medium">
              <span class="text-slate-500">ข้อที่</span>
              <strong id="stat-progress" class="text-slate-900">1 / 20</strong>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-xs sm:text-sm font-medium">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>ถูกสมบูรณ์: <strong id="stat-score">0</strong></span>
            </div>
          </div>

          <!-- Utility Navigator Controls -->
          <div class="flex items-center gap-2">
            <button
              id="btn-randomize"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 transition-colors cursor-pointer"
              title="สุ่มลำดับข้อสอบในหมวดนี้"
            >
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>สุ่มข้อ</span>
            </button>
            <button
              id="btn-reset-all"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium bg-white hover:bg-rose-50 text-slate-600 hover:text-rose-700 border border-slate-200 hover:border-rose-200 transition-colors cursor-pointer"
              title="เริ่มทำหมวดนี้ใหม่ทั้งหมด"
            >
              <span>รีเซ็ตชุดนี้</span>
            </button>
          </div>
        </div>

        <!-- Thin Progress Bar -->
        <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full transition-all duration-300" style="width: 5%;"></div>
        </div>
      </section>

      <!-- Active Exercise Workspace -->
      <div id="exercise-container" class="space-y-5">
        <article class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden">

          <!-- Question Card Top Bar -->
          <div class="px-5 sm:px-7 py-4 bg-slate-50/80 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span id="q-number-badge" class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-900 text-white text-xs font-bold">
                ข้อ 1
              </span>
              <span id="q-difficulty-badge" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold">
                พื้นฐาน
              </span>
              <span id="q-chapter-badge" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-white border border-slate-200 text-slate-600 font-kr">
                บทที่ 3: 명사절
              </span>
            </div>

            <!-- Audio, Translation, Hint Toggles -->
            <div class="flex flex-wrap items-center gap-2">
              <button
                id="btn-tts"
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200 hover:border-blue-200 transition-colors cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                </svg>
                <span>ฟังเสียง</span>
              </button>

              <button
                id="btn-toggle-trans"
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 transition-colors cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                </svg>
                <span id="label-trans">แปลภาษาไทย</span>
              </button>

              <button
                id="btn-toggle-hint"
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-700 border border-slate-200 hover:border-amber-200 transition-colors cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
                <span id="label-hint">คำใบ้</span>
              </button>
            </div>
          </div>

          <!-- Question Card Body -->
          <div class="p-5 sm:p-7 space-y-7">

            <!-- Collapsible Translation & Hint -->
            <div id="helper-boxes" class="hidden space-y-2.5">
              <div id="box-trans" class="hidden animate-fade-in px-4 py-3 rounded-2xl bg-blue-50/70 border border-blue-200/70 text-sm text-blue-950 flex items-start gap-2.5">
                <span class="font-semibold text-blue-700 shrink-0">คำแปล:</span>
                <span id="text-trans"></span>
              </div>
              <div id="box-hint" class="hidden animate-fade-in px-4 py-3 rounded-2xl bg-amber-50/80 border border-amber-200/80 text-sm text-amber-950 flex items-start gap-2.5">
                <span class="font-semibold text-amber-700 shrink-0">คำใบ้:</span>
                <span id="text-hint"></span>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- STEP 1: SEGMENT HIGHLIGHTING               -->
            <!-- ========================================== -->
            <section class="space-y-3.5">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0">1</span>
                  <h2 class="text-sm sm:text-base font-bold text-slate-900">
                    ขั้นตอนที่ 1: ระบายสีแยกส่วนประโยค
                  </h2>
                </div>
                <span class="text-xs text-slate-500">เลือกพู่กันแล้วคลิกที่กลุ่มคำด้านล่าง</span>
              </div>

              <!-- Helpful Rule Note -->
              <div class="px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-slate-600 flex items-start gap-2 leading-relaxed">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>
                  <strong>หลักการ:</strong> คำนามที่ถูกขยาย (<span class="font-kr text-emerald-700 font-medium">수식받는 명사</span>) ถือเป็นส่วนหนึ่งของ<strong class="text-blue-700">ประโยคหลัก</strong> ส่วนอนุประโยคที่ขยายหรือซ้อนอยู่ให้ระบายเป็น<strong class="text-amber-700">อนุประโยค / ส่วนขยาย</strong> (สำหรับ <span class="font-kr">이어진 문장</span> ให้ระบายประโยคหน้าเป็นอนุประโยค และประโยคหลังเป็นประโยคหลัก)
                </span>
              </div>

              <!-- Brush Selector Buttons -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" id="brush-palette">
                <button type="button" data-brush="main" class="brush-btn flex items-center gap-3 px-4 py-3 rounded-2xl border-2 text-left transition-all cursor-pointer">
                  <span class="w-3.5 h-3.5 rounded-full bg-blue-500 shrink-0 ring-4 ring-blue-100"></span>
                  <div class="leading-tight">
                    <div class="text-sm font-bold">ประโยคหลัก</div>
                    <div class="text-[11px] font-kr opacity-80">안은 문장 / 주절</div>
                  </div>
                </button>

                <button type="button" data-brush="clause" class="brush-btn flex items-center gap-3 px-4 py-3 rounded-2xl border-2 text-left transition-all cursor-pointer">
                  <span class="w-3.5 h-3.5 rounded-full bg-amber-500 shrink-0 ring-4 ring-amber-100"></span>
                  <div class="leading-tight">
                    <div class="text-sm font-bold">อนุประโยค / ส่วนขยาย</div>
                    <div class="text-[11px] font-kr opacity-80">안긴 절 / 종속절</div>
                  </div>
                </button>

                <button type="button" data-brush="erase" class="brush-btn flex items-center gap-3 px-4 py-3 rounded-2xl border-2 text-left transition-all cursor-pointer">
                  <svg class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  <div class="leading-tight">
                    <div class="text-sm font-bold">ยางลบ</div>
                    <div class="text-[11px] opacity-80">ล้างสีที่เลือก</div>
                  </div>
                </button>
              </div>

              <!-- Clickable Korean Sentence Area -->
              <div class="bg-[#faf9f6] border border-slate-200/90 rounded-2xl px-4 sm:px-6 py-9 min-h-[136px] flex items-center justify-center">
                <div id="sentence-chips" class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-8 leading-relaxed">
                  <!-- Chips injected by JS -->
                </div>
              </div>
            </section>

            <!-- ========================================== -->
            <!-- STEP 2: MAIN CLAUSE TYPE SELECTION         -->
            <!-- ========================================== -->
            <section class="space-y-3 pt-2 border-t border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0">2</span>
                <h2 class="text-sm sm:text-base font-bold text-slate-900">
                  ขั้นตอนที่ 2: เลือกประเภทหลักของอนุประโยค (<span class="font-kr text-indigo-700">절의 유형</span>)
                </h2>
              </div>

              <div id="main-type-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                <!-- 6 Main Type Cards injected by JS -->
              </div>
            </section>

            <!-- ========================================== -->
            <!-- STEP 3: SUBTYPE SELECTION (DYNAMIC)        -->
            <!-- ========================================== -->
            <section id="step-3-section" class="space-y-3 pt-2 border-t border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0">3</span>
                <h2 class="text-sm sm:text-base font-bold text-slate-900">
                  ขั้นตอนที่ 3: เลือกประเภทย่อย (<span class="font-kr text-indigo-700">세부 유형</span>)
                </h2>
              </div>

              <div id="subtype-container">
                <!-- Dynamically populated based on Step 2 -->
              </div>
            </section>

            <!-- ========================================== -->
            <!-- ACTION BUTTONS & NAVIGATION                -->
            <!-- ========================================== -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-4 border-t border-slate-100">
              <div class="flex flex-wrap items-center gap-2">
                <button
                  id="btn-check"
                  type="button"
                  class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-[0.98] text-white font-semibold text-sm shadow-sm transition-all cursor-pointer"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>ตรวจคำตอบ</span>
                </button>

                <button
                  id="btn-solution"
                  type="button"
                  class="inline-flex items-center justify-center gap-1.5 px-4 py-3 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 font-semibold text-sm border border-amber-200 transition-colors cursor-pointer"
                >
                  <span>ดูเฉลยทันที</span>
                </button>

                <button
                  id="btn-reset-q"
                  type="button"
                  class="inline-flex items-center justify-center gap-1.5 px-4 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-600 font-medium text-sm border border-slate-200 transition-colors cursor-pointer"
                >
                  <span>ล้างข้อนี้</span>
                </button>
              </div>

              <div class="flex items-center gap-2">
                <button
                  id="btn-prev"
                  type="button"
                  class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1 px-4 py-3 rounded-xl bg-white hover:bg-slate-100 disabled:opacity-40 disabled:pointer-events-none text-slate-700 font-medium text-sm border border-slate-200 transition-colors cursor-pointer"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  <span>ก่อนหน้า</span>
                </button>

                <button
                  id="btn-next"
                  type="button"
                  class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1 px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm transition-colors cursor-pointer"
                >
                  <span id="label-next">ข้อถัดไป</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </article>

        <!-- ========================================== -->
        <!-- DETAILED EXPLANATION PANEL                 -->
