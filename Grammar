    function renderMainTabs() {
      el.mainTabs.forEach((btn) => {
        const active = btn.dataset.view === state.activeView;
        btn.className = `main-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${
          active
            ? 'bg-white text-blue-700 shadow-xs'
            : 'text-slate-600 hover:text-slate-900'
        }`;
      });
      el.viewPractice.classList.toggle('hidden', state.activeView !== 'practice');
      el.viewGuide.classList.toggle('hidden', state.activeView !== 'guide');
    }

    function renderCategoryFilters() {
      const categories = [
        { id: 'all', label: `ทั้งหมด (${QUESTIONS.length})` },
        ...MAIN_TYPES.map((t) => ({
          id: t.id,
          label: `${t.kr} (${QUESTIONS.filter((q) => q.mainType === t.id).length})`,
        })),
      ];

      el.categoryFilters.innerHTML = '';
      categories.forEach((cat) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isActive = state.activeCategory === cat.id;
        btn.className = `shrink-0 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all cursor-pointer font-kr ${
          isActive
            ? 'bg-slate-900 text-white shadow-xs font-semibold'
            : 'bg-slate-100/90 text-slate-600 hover:bg-slate-200/80 hover:text-slate-900'
        }`;
        btn.textContent = cat.label;
        btn.addEventListener('click', () => selectCategory(cat.id));
        el.categoryFilters.appendChild(btn);
      });
    }

