    function updateHelperBoxes() {
      const any = state.showTrans || state.showHint;
      el.helperBoxes.classList.toggle('hidden', !any);
      el.boxTrans.classList.toggle('hidden', !state.showTrans);
      el.boxHint.classList.toggle('hidden', !state.showHint);
      el.labelTrans.textContent = state.showTrans ? 'ซ่อนคำแปล' : 'แปลภาษาไทย';
      el.labelHint.textContent = state.showHint ? 'ซ่อนคำใบ้' : 'คำใบ้';
    }

    function renderQuestion() {
      const q = state.questionList[state.currentIndex];
      if (!q) return;

      const prog = getProgress(q.id);
      const total = state.questionList.length;

      el.exerciseContainer.classList.remove('hidden');
      el.summaryContainer.classList.add('hidden');

      // Status bar
      el.statProgress.textContent = `${state.currentIndex + 1} / ${total}`;
      el.statScore.textContent = getPerfectCount(state.questionList);
      el.progressBar.style.width = `${((state.currentIndex + 1) / total) * 100}%`;

      // Header badges
      el.qNumberBadge.textContent = `ข้อ ${state.currentIndex + 1}`;
      const diff = DIFFICULTY_META[q.difficulty];
      el.qDifficultyBadge.textContent = diff.label;
      el.qDifficultyBadge.className = `inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${diff.cls}`;
      el.qChapterBadge.textContent = q.chapter;

      // Translation & Hint
      el.textTrans.textContent = q.thai;
      el.textHint.textContent = q.hint;
      updateHelperBoxes();

      // Step 1: Render Sentence Chips
      el.sentenceChips.innerHTML = '';
      q.segments.forEach((seg, idx) => {
        const chosen = prog.segments[idx];
        const btn = document.createElement('button');
        btn.type = 'button';

        let cls =
          'relative inline-flex items-center justify-center px-4 py-2.5 rounded-2xl border-2 font-kr text-lg sm:text-2xl font-medium transition-all select-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400/40';

        if (prog.checked) {
          const isOk = chosen === seg.role;
          if (isOk) {
            if (seg.modifiedNoun) {
              cls += ' bg-emerald-50 border-emerald-500 text-emerald-950 ring-2 ring-emerald-400/40';
            } else if (seg.role === 'main') {
              cls += ' bg-blue-50 border-blue-500 text-blue-950 ring-2 ring-emerald-400/40';
            } else {
              cls += ' bg-amber-50 border-amber-500 text-amber-950 ring-2 ring-emerald-400/40';
            }
          } else {
            cls += ' bg-rose-50 border-rose-500 text-rose-950 ring-2 ring-rose-300/60';
          }
        } else if (chosen === 'main') {
          cls += ' bg-blue-50 border-blue-500 text-blue-950 shadow-xs';
        } else if (chosen === 'clause') {
          cls += ' bg-amber-50 border-amber-500 text-amber-950 shadow-xs';
        } else {
          cls += ' bg-white border-slate-300 border-dashed text-slate-800 hover:border-blue-400 hover:bg-blue-50/30';
        }
        btn.className = cls;

        // Top floating label
        if (chosen) {
          const tag = document.createElement('span');
          const wrong = prog.checked && chosen !== seg.role;
          const labelText = chosen === 'main' ? 'ประโยคหลัก' : 'อนุประโยค';
          let tagBg = chosen === 'main' ? 'bg-blue-600 text-white' : 'bg-amber-500 text-white';
          if (wrong) tagBg = 'bg-rose-600 text-white';
          else if (prog.checked && seg.modifiedNoun) tagBg = 'bg-emerald-600 text-white';

          tag.className = `absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap px-2.5 py-0.5 rounded-full text-[11px] font-thai font-semibold shadow-xs flex items-center gap-1 ${tagBg}`;

          if (prog.checked) {
            const icon = wrong
              ? '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>'
              : '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>';
            const displayLabel = !wrong && seg.modifiedNoun ? 'หลัก·นามถูกขยาย' : labelText;
            tag.innerHTML = `${icon}<span>${displayLabel}</span>`;
          } else {
            tag.textContent = labelText;
          }
          btn.appendChild(tag);
        }

        // Main Korean text
        const span = document.createElement('span');
        span.textContent = seg.text;
        btn.appendChild(span);

        // Bottom correction pill if wrong after check
        if (prog.checked && chosen !== seg.role) {
          const fix = document.createElement('span');
          const correctLabel = seg.role === 'main' ? (seg.modifiedNoun ? 'หลัก (นามถูกขยาย)' : 'ประโยคหลัก') : 'อนุประโยค';
          const colorCls = seg.role === 'main' ? 'text-blue-700' : 'text-amber-700';
          fix.className = 'absolute -bottom-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-0.5 rounded-full text-[10px] font-thai font-semibold bg-white border border-slate-300 shadow-xs text-slate-700';
          fix.innerHTML = `ที่ถูก: <span class="${colorCls}">${correctLabel}</span>`;
          btn.appendChild(fix);
        }

        btn.addEventListener('click', () => handleSegmentClick(idx));
        el.sentenceChips.appendChild(btn);
      });

      // Step 2: Render Main Types
      renderMainTypes(q, prog);

      // Step 3: Render Subtypes
      renderSubtypes(q, prog);

      // Explanation Panel
      if (prog.checked) {
        renderExplanation(q, prog);
      } else {
        el.explanationPanel.classList.add('hidden');
      }

      // Nav buttons
      el.btnPrev.disabled = state.currentIndex === 0;
      el.labelNext.textContent = state.currentIndex === total - 1 ? 'ดูสรุปผลคะแนน' : 'ข้อถัดไป';
    }

    function renderMainTypes(q, prog) {
      el.mainTypeGrid.innerHTML = '';
      MAIN_TYPES.forEach((t) => {
        const isSelected = prog.mainType === t.id;
        const isCorrectAnswer = q.mainType === t.id;
        const btn = document.createElement('button');
        btn.type = 'button';

        let cls = 'p-3.5 rounded-2xl border-2 text-left transition-all cursor-pointer flex flex-col justify-between gap-1 ';
        if (prog.checked) {
          if (isSelected && isCorrectAnswer) {
            cls += 'bg-emerald-50 border-emerald-500 text-emerald-950 ring-2 ring-emerald-400/30';
          } else if (isSelected && !isCorrectAnswer) {
            cls += 'bg-rose-50 border-rose-500 text-rose-950';
          } else if (!isSelected && isCorrectAnswer) {
            cls += 'bg-emerald-50/50 border-emerald-400 border-dashed text-emerald-900';
          } else {
            cls += 'bg-white border-slate-200/70 text-slate-400 opacity-70';
          }
        } else if (isSelected) {
          cls += 'bg-blue-50 border-blue-600 text-blue-950 ring-2 ring-blue-500/20 shadow-xs';
        } else {
          cls += 'bg-white border-slate-200 text-slate-700 hover:border-blue-300 hover:bg-slate-50/80';
        }

        btn.className = cls;
        btn.innerHTML = `
          <div class="flex items-center justify-between gap-1">
            <span class="font-kr font-bold text-sm sm:text-base">${t.kr}</span>
            ${
              prog.checked && isCorrectAnswer
                ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-600 text-white">ถูก</span>'
                : prog.checked && isSelected && !isCorrectAnswer
                ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-rose-600 text-white">ผิด</span>'
                : ''
            }
          </div>
          <div class="text-xs opacity-90">${t.th}</div>
          <div class="text-[11px] font-kr opacity-65 mt-0.5">${t.hint}</div>
        `;

        btn.addEventListener('click', () => handleSelectMainType(t.id));
        el.mainTypeGrid.appendChild(btn);
      });
    }

    function renderSubtypes(q, prog) {
      el.subtypeContainer.innerHTML = '';

      if (!prog.mainType) {
        el.subtypeContainer.innerHTML = `
          <div class="px-4 py-5 rounded-2xl bg-slate-50 border border-dashed border-slate-300 text-center text-xs sm:text-sm text-slate-500">
            กรุณาเลือก <strong>ประเภทหลักของอนุประโยค (ขั้นตอนที่ 2)</strong> ก่อน เพื่อแสดงตัวเลือกประเภทย่อยครับ
          </div>
        `;
        return;
      }

      const list = SUBTYPES_MAP[prog.mainType] || [];
      const grid = document.createElement('div');
      grid.className = `grid grid-cols-1 ${list.length > 1 ? 'sm:grid-cols-2' : ''} gap-2.5 animate-fade-in`;

      list.forEach((sub) => {
        const isSelected = prog.subType === sub.id;
        const isCorrectAnswer = q.subType === sub.id;
        const btn = document.createElement('button');
        btn.type = 'button';

        let cls = 'p-4 rounded-2xl border-2 text-left transition-all cursor-pointer space-y-1 ';
        if (prog.checked) {
          if (isSelected && isCorrectAnswer) {
            cls += 'bg-emerald-50 border-emerald-500 text-emerald-950 ring-2 ring-emerald-400/30';
          } else if (isSelected && !isCorrectAnswer) {
            cls += 'bg-rose-50 border-rose-500 text-rose-950';
          } else if (!isSelected && isCorrectAnswer) {
            cls += 'bg-emerald-50/50 border-emerald-400 border-dashed text-emerald-900';
          } else {
            cls += 'bg-white border-slate-200/70 text-slate-400 opacity-70';
          }
        } else if (isSelected) {
          cls += 'bg-indigo-50 border-indigo-600 text-indigo-950 ring-2 ring-indigo-500/20 shadow-xs';
        } else {
          cls += 'bg-white border-slate-200 text-slate-700 hover:border-indigo-300 hover:bg-slate-50/80';
        }

        btn.className = cls;
        btn.innerHTML = `
          <div class="flex items-center justify-between gap-2">
            <span class="font-kr font-bold text-sm sm:text-base">${sub.title}</span>
            ${
              prog.checked && isCorrectAnswer
                ? '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-600 text-white shrink-0">ถูกต้อง</span>'
                : prog.checked && isSelected && !isCorrectAnswer
                ? '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-600 text-white shrink-0">ไม่ตรง</span>'
                : ''
            }
          </div>
          <p class="text-xs opacity-85 leading-relaxed">${sub.desc}</p>
        `;

        btn.addEventListener('click', () => handleSelectSubType(sub.id));
        grid.appendChild(btn);
      });

      el.subtypeContainer.appendChild(grid);
    }

    function renderExplanation(q, prog) {
      el.explanationPanel.classList.remove('hidden');
      const res = prog.results;

      // Status Header
      if (prog.revealed) {
        el.expStatusIcon.className = 'w-9 h-9 rounded-2xl flex items-center justify-center shrink-0 bg-amber-100 text-amber-700';
        el.expStatusIcon.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>';
        el.expStatusTitle.textContent = 'เฉลยโครงสร้างประโยค';
        el.expStatusSub.textContent = 'ศึกษาโครงสร้างและเกณฑ์การตรวจสอบด้านล่างได้เลยครับ';
      } else if (res.perfect) {
        el.expStatusIcon.className = 'w-9 h-9 rounded-2xl flex items-center justify-center shrink-0 bg-emerald-100 text-emerald-700';
        el.expStatusIcon.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
        el.expStatusTitle.textContent = 'ยอดเยี่ยม! วิเคราะห์ถูกต้องครบทั้ง 3 ขั้นตอน';
        el.expStatusSub.textContent = 'คุณแยกส่วนประโยค ประเภทหลัก และประเภทย่อยได้แม่นยำสมบูรณ์';
      } else {
        const count = [res.segOk, res.mainOk, res.subOk].filter(Boolean).length;
        el.expStatusIcon.className = 'w-9 h-9 rounded-2xl flex items-center justify-center shrink-0 bg-rose-100 text-rose-700';
        el.expStatusIcon.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>';
        el.expStatusTitle.textContent = `ถูกบางส่วน (${count} / 3 ขั้นตอน)`;
        el.expStatusSub.textContent = 'ดูจุดที่ยังไม่ตรงจากป้ายด้านขวา และอ่านคำอธิบายประกอบด้านล่าง';
      }

      // 3 Individual Pass/Fail Badges
      const makeBadge = (label, ok) => {
        if (prog.revealed) {
          return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">${label}: เฉลย</span>`;
        }
        return ok
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">✓ ${label}</span>`
          : `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">✗ ${label}</span>`;
      };

      el.expStepBadges.innerHTML =
        makeBadge('1. แยกส่วน', res.segOk) +
        makeBadge('2. ประเภทหลัก', res.mainOk) +
        makeBadge('3. ประเภทย่อย', res.subOk);

      // Bracketed analysis with highlighted brackets
      const highlightedBracket = q.bracketed.replace(
        /\[([^\]]+)\]/g,
        '<span class="text-amber-300 font-bold">[$1]</span>'
      );
      el.expBracketed.innerHTML = highlightedBracket;
      el.expTranslation.textContent = `คำแปล: ${q.thai}`;

      const subObj = getSubtypeObj(q.mainType, q.subType);
      el.expCorrectTypes.textContent = `${q.mainType} → ${subObj ? subObj.title : q.subType}`;
      el.expMatrixRole.textContent = q.matrixRole;
      el.expDiagnostic.textContent = q.diagnostic;
      el.expDetail.textContent = q.explanation;
    }

    function renderSummary() {
      el.exerciseContainer.classList.add('hidden');
      el.summaryContainer.classList.remove('hidden');

      const list = state.questionList;
      const total = list.length;
      const perfect = getPerfectCount(list);
      const acc = total > 0 ? Math.round((perfect / total) * 100) : 0;

      const catTitle = state.activeCategory === 'all' ? 'ทั้งหมด (ทุกประเภท)' : state.activeCategory;
      el.summaryCategoryLabel.textContent = `หมวดที่ฝึก: ${catTitle}`;
      el.sumTotal.textContent = `${total} ข้อ`;
      el.sumPerfect.textContent = `${perfect} ข้อ`;
      el.sumAccuracy.textContent = `${acc}%`;

      // Breakdown by mainType present in current list
      const typesInList = [...new Set(list.map((q) => q.mainType))];
      el.summaryBreakdown.innerHTML = '';

      typesInList.forEach((typeId) => {
        const subset = list.filter((q) => q.mainType === typeId);
        const subPerfect = getPerfectCount(subset);
        const pct = Math.round((subPerfect / subset.length) * 100);
        const meta = MAIN_TYPES.find((t) => t.id === typeId);

        const row = document.createElement('div');
        row.className = 'p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2';
        row.innerHTML = `
          <div class="flex items-center justify-between text-xs sm:text-sm">
            <div class="font-semibold text-slate-800">
              <span class="font-kr text-indigo-700">${typeId}</span>
              <span class="text-slate-500 font-normal ml-1">(${meta ? meta.th : ''})</span>
            </div>
            <div class="font-bold text-slate-900">${subPerfect} / ${subset.length} ข้อ (${pct}%)</div>
          </div>
          <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
            <div class="h-full bg-emerald-500 rounded-full transition-all" style="width: ${pct}%;"></div>
          </div>
        `;
        el.summaryBreakdown.appendChild(row);
      });
    }

    /**
     * =========================================================================
     * 6. INTERACTION HANDLERS
     * =========================================================================
     */
    function handleSegmentClick(idx) {
      const q = state.questionList[state.currentIndex];
      const prog = getProgress(q.id);
      if (prog.checked) {
        prog.checked = false;
      }

      if (state.activeBrush === 'erase') {
        delete prog.segments[idx];
      } else if (prog.segments[idx] === state.activeBrush) {
        delete prog.segments[idx];
      } else {
        prog.segments[idx] = state.activeBrush;
      }
      renderQuestion();
    }

    function handleSelectMainType(typeId) {
      const q = state.questionList[state.currentIndex];
      const prog = getProgress(q.id);
      if (prog.checked) {
        prog.checked = false;
      }

      if (prog.mainType !== typeId) {
        prog.mainType = typeId;
        const subs = SUBTYPES_MAP[typeId] || [];
        // Auto-select if only 1 subtype exists (e.g., 서술절)
        prog.subType = subs.length === 1 ? subs[0].id : null;
      }
      renderQuestion();
    }

    function handleSelectSubType(subId) {
      const q = state.questionList[state.currentIndex];
      const prog = getProgress(q.id);
      if (prog.checked) {
        prog.checked = false;
      }
      prog.subType = subId;
      renderQuestion();
    }

    function handleCheckAnswer() {
      const q = state.questionList[state.currentIndex];
      const prog = getProgress(q.id);

      // Validate all 3 steps are filled
      const taggedCount = Object.keys(prog.segments).length;
      if (taggedCount < q.segments.length) {
        showToast('ขั้นตอนที่ 1: กรุณาระบายสีประโยคหลักและอนุประโยคให้ครบทุกคำก่อนครับ', 'warn');
        return;
      }
      if (!prog.mainType) {
        showToast('ขั้นตอนที่ 2: กรุณาเลือกประเภทหลักของอนุประโยคครับ', 'warn');
        return;
      }
      if (!prog.subType) {
        showToast('ขั้นตอนที่ 3: กรุณาเลือกประเภทย่อยของอนุประโยคครับ', 'warn');
        return;
      }

      const segOk = q.segments.every((s, idx) => prog.segments[idx] === s.role);
      const mainOk = prog.mainType === q.mainType;
      const subOk = prog.subType === q.subType;
      const perfect = segOk && mainOk && subOk;

      prog.checked = true;
      prog.results = { segOk, mainOk, subOk, perfect };

      renderQuestion();

      if (perfect && !prog.revealed) {
        showToast('ถูกต้องสมบูรณ์ครบทั้ง 3 ขั้นตอน! เก่งมากครับ', 'success');
      } else {
        showToast('ตรวจคำตอบแล้ว ดูรายละเอียดเฉลยด้านล่างได้เลยครับ', 'info');
      }
    }

    function handleShowSolution() {
      const q = state.questionList[state.currentIndex];
      const prog = getProgress(q.id);

      const alreadySolvedLegit = prog.checked && !prog.revealed && prog.results && prog.results.perfect;

      q.segments.forEach((s, idx) => {
        prog.segments[idx] = s.role;
      });
      prog.mainType = q.mainType;
      prog.subType = q.subType;
      prog.checked = true;
      prog.results = { segOk: true, mainOk: true, subOk: true, perfect: true };

      if (!alreadySolvedLegit) {
        prog.revealed = true;
      }

      renderQuestion();
    }

    function handleResetCurrentQuestion() {
      const q = state.questionList[state.currentIndex];
      delete state.progress[q.id];
      renderQuestion();
      showToast('ล้างคำตอบข้อนี้แล้ว', 'info');
    }

    function selectCategory(catId) {
      state.activeCategory = catId;
      state.questionList =
        catId === 'all' ? [...QUESTIONS] : QUESTIONS.filter((q) => q.mainType === catId);
      state.currentIndex = 0;
      state.showTrans = false;
      state.showHint = false;
      renderCategoryFilters();
      renderQuestion();
    }

    function handleRandomize() {
      const arr = [...state.questionList];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      state.questionList = arr;
      state.currentIndex = 0;
      state.showTrans = false;
      state.showHint = false;
      renderQuestion();
      showToast('สุ่มลำดับข้อสอบเรียบร้อยแล้ว', 'info');
    }

    function handleResetSet() {
      state.questionList.forEach((q) => delete state.progress[q.id]);
      state.currentIndex = 0;
      state.showTrans = false;
      state.showHint = false;
      renderQuestion();
      showToast('รีเซ็ตคะแนนในชุดนี้เรียบร้อยแล้ว', 'info');
    }

    function handleTTS() {
      const q = state.questionList[state.currentIndex];
      if (!q) return;
      const fullText = q.segments.map((s) => s.text).join(' ');

      if (!('speechSynthesis' in window)) {
        showToast('เบราว์เซอร์นี้ไม่รองรับการอ่านออกเสียงภาษาเกาหลี', 'error');
        return;
      }

      try {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(fullText);
        utter.lang = 'ko-KR';
        utter.rate = 0.88;
        const voices = window.speechSynthesis.getVoices();
        const koVoice = voices.find((v) => v.lang && v.lang.toLowerCase().startsWith('ko'));
        if (koVoice) utter.voice = koVoice;

        el.btnTts.classList.add('bg-blue-100', 'text-blue-700', 'border-blue-300');
        utter.onend = () => el.btnTts.classList.remove('bg-blue-100', 'text-blue-700', 'border-blue-300');
        utter.onerror = () => {
          el.btnTts.classList.remove('bg-blue-100', 'text-blue-700', 'border-blue-300');
          showToast('ไม่สามารถเล่นเสียงได้ในขณะนี้', 'warn');
        };
        window.speechSynthesis.speak(utter);
      } catch (e) {
        showToast('เกิดข้อผิดพลาดในการเล่นเสียง', 'error');
      }
    }

    /**
     * =========================================================================
     * 7. INITIALIZATION
     * =========================================================================
     */
    function init() {
      // Main view switching
      el.mainTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          state.activeView = tab.dataset.view;
          renderMainTabs();
        });
      });

      // Brush selector
      el.brushBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          state.activeBrush = btn.dataset.brush;
          renderBrushes();
        });
      });

      // Utility controls
      el.btnTts.addEventListener('click', handleTTS);
      el.btnToggleTrans.addEventListener('click', () => {
        state.showTrans = !state.showTrans;
        updateHelperBoxes();
      });
      el.btnToggleHint.addEventListener('click', () => {
        state.showHint = !state.showHint;
        updateHelperBoxes();
      });
      el.btnRandomize.addEventListener('click', handleRandomize);
      el.btnResetAll.addEventListener('click', handleResetSet);

      // Exercise actions
      el.btnCheck.addEventListener('click', handleCheckAnswer);
      el.btnSolution.addEventListener('click', handleShowSolution);
      el.btnResetQ.addEventListener('click', handleResetCurrentQuestion);

      // Navigation
      el.btnPrev.addEventListener('click', () => {
        if (state.currentIndex > 0) {
          state.currentIndex--;
          state.showTrans = false;
          state.showHint = false;
          renderQuestion();
        }
      });

      el.btnNext.addEventListener('click', () => {
        if (state.currentIndex < state.questionList.length - 1) {
          state.currentIndex++;
          state.showTrans = false;
          state.showHint = false;
          renderQuestion();
        } else {
          renderSummary();
        }
      });

      // Summary buttons
      el.btnSumRetry.addEventListener('click', handleResetSet);
      el.btnSumAll.addEventListener('click', () => selectCategory('all'));
      el.btnSumGuide.addEventListener('click', () => {
        state.activeView = 'guide';
        renderMainTabs();
      });

      if ('speechSynthesis' in window) {
        window.speechSynthesis.getVoices();
      }

      // First Render
      renderMainTabs();
      renderCategoryFilters();
      renderBrushes();
      renderQuestion();
    }

    document.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
