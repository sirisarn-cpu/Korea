    function showToast(msg, type = 'info') {
      const palette = {
        info: 'bg-slate-900 text-white',
        warn: 'bg-amber-600 text-white',
        error: 'bg-rose-600 text-white',
        success: 'bg-emerald-600 text-white',
      };
      const div = document.createElement('div');
      div.className = `pointer-events-auto px-4 py-3 rounded-2xl shadow-lg text-xs sm:text-sm font-medium animate-pop ${palette[type] || palette.info}`;
      div.textContent = msg;
      el.toastContainer.appendChild(div);
      setTimeout(() => {
        div.style.opacity = '0';
        div.style.transform = 'translateY(-6px)';
        div.style.transition = 'all 0.25s ease';
        setTimeout(() => div.remove(), 260);
      }, 2600);
    }

    function getProgress(qId) {
      if (!state.progress[qId]) {
        state.progress[qId] = {
          segments: {},
          mainType: null,
          subType: null,
          checked: false,
          revealed: false,
          results: null,
        };
      }
      return state.progress[qId];
    }

    function getSubtypeObj(mainType, subTypeId) {
      const list = SUBTYPES_MAP[mainType] || [];
      return list.find((s) => s.id === subTypeId) || null;
    }

    function getPerfectCount(list) {
      return list.reduce((acc, q) => {
        const p = state.progress[q.id];
        return acc + (p && p.checked && !p.revealed && p.results && p.results.perfect ? 1 : 0);
      }, 0);
    }

